%% 记忆闭环（memory_loop）增量时序图
%% 含两条主链路：① 总控对话落盘+归档；② 质检失败→沉淀教训→下次召回

%% ============ ① 总控对话落盘 + 按日期归档（T02） ============
sequenceDiagram
    autonumber
    participant U as 用户
    participant API as app.api_agent_chat(@9474)
    participant H as ai_chat.load/save_history
    participant AR as archive/<key>/<date>.jsonl
    participant J as agent_core job
    participant P as app.api_agent_job(@9521)

    U->>API: POST /api/agent/chat {message, project}
    API->>H: load_history(chat_history.json)  %% 只读热窗口 ≤40（有界）
    API->>H: append_message(history,"user",msg,project)  %% ★ 生成 msg_id
    API->>H: save_history(path, history)  %% @_locked
    H->>H: 计算未归档尾巴（archived_upto 水位线之后）
    H->>AR: _archive_append(key, tail)  %% ★ 追加式 jsonl，只增不减
    H->>H: 更新 archived_upto = tail[-1].msg_id
    H->>H: bucket.messages = msgs[-HISTORY_MAX_MESSAGES:]  %% 热窗口截断
    H->>H: _write_json(chat_history.json)  %% 唯一临时名+fsync+os.replace
    API->>J: start_job(messages=project_messages(history)[:-1])
    Note over J: 送模型历史仍取 CONTEXT_MESSAGES=20，与归档总量无关（解耦）
    U->>P: GET /api/agent/job/<id>（轮询）
    P->>H: load_history + append_message(assistant) + save_history  %% _persisted 去重
    H->>AR: 归档总控回复（同水位线，幂等）

%% ============ ② 质检失败→沉淀教训→下次召回（T01/T03） ============
sequenceDiagram
    autonumber
    participant G as 生成链路(asset/storyboard/video/keyframe/audio/script)
    participant PM as prompt_memory（唯一实例）
    participant F as lessons.jsonl
    participant QC as 质检(qc_client / prompt_qc)

    Note over G,QC: 第 N 次生成 → 不达标
    G->>QC: check_image / check_video / check_audio / check_script / preflight
    QC-->>G: verdict(ok, passed, issues, score)
    G->>G: _qc_record_verdict(...) 生成 rec
    G->>G: _record_qc_lesson(project, kind, 原始prompt, rec)
    G->>PM: record(project, kind, prompt, issues, reason, score)
    PM->>PM: _normalize_lesson → lesson_id；use_count=0
    PM->>F: _flush() 原子覆盖写（唯一写者 → 无双单例互抹）
    Note over G: 同一次重试循环的下一次即可召回本条

    G->>PM: learned_prompt(kind, 原始prompt, project, style)
    PM->>PM: suggestions()：sim + kw_hit(查询提示词) + proj_bonus 打分
    PM->>PM: mark_used(命中的 lesson_id) → use_count++ / last_used=now
    PM->>F: _flush() 回写召回计数
    PM-->>G: 叠加【历史质检修正建议】的提示词
    alt kind == audio
        G->>G: _apply_audio_hints(line, hints)  %% 计划级纠偏；ln["audio_hints"] 审计
        Note over G: 建议绝不拼进 ln["text"]（否则会被 TTS 念出来）
    else keyframe
        G->>G: recall_cb(orig_prompt, shot, item)  %% generate_keyframes 重试时改写提示词
    end
    G->>QC: 用改写后的提示词重新生成

%% ============ ③ 教训管理读取/删除（T04） ============
sequenceDiagram
    autonumber
    participant MP as MemoryPage.tsx
    participant CL as api/client.ts
    participant RT as app.py memory API
    participant PM as prompt_memory（唯一实例）
    participant F as lessons.jsonl

    MP->>CL: memoryApi.lessons({kinds,project,since,until,q,limit,offset})
    CL->>RT: GET /api/memory/lessons?...
    RT->>PM: query(...)
    PM->>F: 读取（内存列表）
    PM-->>RT: {items,total,filtered,by_kind,dead_lessons}
    RT-->>CL: {success,total,filtered,lessons[]}
    CL-->>MP: PromptLesson[]（含 use_count/last_used）
    MP->>CL: memoryApi.deleteLesson(lesson_id)  %% ConfirmDialog(danger) 二次确认
    CL->>RT: DELETE /api/memory/lessons/<lesson_id>
    RT->>PM: delete(lesson_id)
    PM->>F: _flush() 原子写
    PM-->>RT: true
    RT-->>CL: {success,deleted:1}
    CL-->>MP: 刷新列表
