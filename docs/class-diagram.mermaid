%% 记忆闭环（memory_loop）增量类图
%% 说明：只画本次变更涉及的类/数据结构与调用关系；★ 为本次新增/变更成员
classDiagram
    direction LR

    class PromptMemory {
        <<唯一实例（原 PromptMemory + PromptMemoryEnhanced 合并）>>
        +str root_dir
        -str _dir
        -str _path  "★ 全模块唯一：<root>/lessons/lessons.jsonl"
        -RLock _lock
        -list _lessons
        -bool _dirty  "★"
        +__init__(root_dir)
        -_load() list
        -_flush()  "★ 原子写：唯一临时名+fsync+os.replace 退避重试"
        +_normalize_lesson(d) dict  "★ 惰性补 lesson_id/use_count/last_used"
        +lesson_id(kind, phash, ts) str  "★ sha1(kind␟phash␟ts)[:16] 确定性派生"
        +record(project, kind, prompt, issues, reason, score) dict
        +record_with_context(project, kind, category, priority, context, prompt, issues, reason, score) dict  "★ 由 Enhanced 折入"
        +suggestions(kind, prompt, project, max_hints, style) List~str~  "★ 命中即 mark_used"
        +suggestions_with_priority(kind, prompt, context, max_hints) List~dict~  "★ 折入"
        +learned_prompt(kind, prompt, project, max_hints, style) str
        +mark_used(lesson_ids) int  "★ use_count++/last_used=now"
        +delete(lesson_id) bool  "★"
        +delete_by_kind(kind) int  "★ 复用 clear"
        +query(kind, kinds, project, since, until, q, limit, offset) dict  "★ 多维筛选+关键词"
        +dead_count() int  "★ use_count==0 条数"
        +list(kind, limit) list
        +stats() dict  "★ 含 by_kind/dead_lessons"
        +clear(kind) int
        +prune_empty() int
        -_similar(a, b) float
        +_render_hint(issue, style) str
        +_calculate_decay_weight(lesson) float
        +decay_old_lessons(threshold) int  "★ 折入"
        +get_learning_curve(project) dict  "★ 折入"
    }

    class PromptMemoryEnhanced {
        <<空壳别名，isinstance 兼容>>
        %% ★ 不再定义 __init__，不再持有独立 _path；_ENHANCED_INSTANCE 已删除
    }

    class Lesson {
        <<数据 · lessons.jsonl 一行>>
        +str lesson_id  "★ L+sha1(kind␟phash␟ts)[:16]"
        +str ts
        +str project
        +str kind  "asset|storyboard|video|keyframe|audio|script|prompt"
        +str phash
        +str prompt  "原始提示词（不含建议块）"
        +list issues
        +str reason
        +int score
        +list terms
        +str category  "可选"
        +str priority  "可选"
        +dict context  "可选"
        +float decay_weight  "可选"
        +int use_count  "★ 默认 0（存量不回填估算）"
        +str last_used  "★ 默认 null"
    }

    class ArchiveMessage {
        <<数据 · archive/<key>/<YYYY-MM-DD>.jsonl 一行>>
        +str msg_id  "★ 热/冷一致"
        +str role
        +str content
        +str time
        +str date
        +str project
        +str project_key
        +int seq
    }

    class AiChatModule {
        <<app/ai_chat.py 模块级>>
        +int HISTORY_MAX_MESSAGES = 40  "热窗口上限（不调大）"
        +int CONTEXT_MESSAGES = 20  "送模型条数，与存档解耦"
        +load_history(path) dict
        +save_history(path, history) dict  "★ 归档尾巴→更新水位线→截断→原子写"
        +append_message(history, role, content, project) dict  "★ 生成 msg_id"
        +drop_last_message(history, project) dict
        +_project_bucket(history, project) dict
        +canonical_project_key(name) str
        +_archive_append(key, msgs) void  "★ 追加式 jsonl（不加 @_locked）"
        +archive_dates(root, key) list  "★"
        +load_archive(root, key, date, limit, offset) list  "★"
        +load_all_messages(history, project) list  "★ 热+冷合并（验收/导出）"
    }

    class MemoryAPI {
        <<app/app.py 路由>>
        +GET /api/memory/lessons  "★ 扩参 kind多值/project/since/until/q/offset"
        +DELETE /api/memory/lessons/~lesson_id~  "★ 新增"
        +POST /api/memory/lessons/clear  "★ 新增"
        +GET /api/memory/stats  "★ 补 dead_lessons/by_kind/used_total"
        +GET /api/memory/lessons/search  "语义不变（召回试算）"
        +GET /api/ai/chat/archive  "★ 新增"
        +GET /api/ai/chat/archive/~date~  "★ 新增"
    }

    class QCLessonRecorder {
        <<app/app.py 沉淀/召回接线>>
        +_record_qc_lesson(project, kind, prompt, rec) dict  "唯一沉淀入口"
        -_qc_lesson_from_record(rec) dict
        -_record_preflight_lesson(project, prompt_orig, pf, gate)  "★ 收敛三处预检沉淀"
        +_keyframe_qc_verifier(project, script)  "★ _verify 内落 keyframe 教训"
        +_keyframe_recall_cb(project)  "★ 尾帧召回"
        +_apply_audio_hints(line, hints)  "★ 计划级纠偏，不进台词"
    }

    class KeyframeModule {
        <<app/keyframe.py>>
        +build_end_frame_prompt(shot, refs, chained) str
        +generate_keyframes(..., verify_cb, preflight_cb, recall_cb)  "★ 新增 recall_cb"
    }

    class ScriptGenerator {
        <<app/script_generator.py>>
        +generate_script(theme, ..., lessons_hint)  "★ 新增 lessons_hint"
        +generate_script_with_qc(...)  "★ 重试前召回 kind=script"
        +_generate_with_claude(...)  "★ 注入历史教训"
    }

    PromptMemoryEnhanced --|> PromptMemory : 空壳继承
    PromptMemory "1" o-- "0..*" Lesson : 持有（唯一写者）
    AiChatModule "1" o-- "0..*" ArchiveMessage : 追加写
    MemoryAPI --> PromptMemory : query/delete/mark_used
    MemoryAPI --> AiChatModule : load_archive
    QCLessonRecorder --> PromptMemory : record / suggest / learned_prompt
    KeyframeModule ..> QCLessonRecorder : recall_cb / verify_cb 注入
    ScriptGenerator ..> QCLessonRecorder : record_with_context / 召回
