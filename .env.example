# ==========================================================================
# 漫剧生成系统 · 环境配置模板
# --------------------------------------------------------------------------
# 用法：复制本文件为 .env 并填入实际值（.env 已被 .gitignore 忽略，不会提交）
#       cp .env.example .env
# ==========================================================================

# ===================== ComfyUI 引擎路径（必填） =====================
# ComfyUI 服务地址
COMFYUI_URL=http://127.0.0.1:8188

# ComfyUI 安装根目录（下面三项默认基于此拼接，也可单独覆盖）
# Windows 示例：D:/ComfyUI_portable_TE_v260619
# Linux/macOS 示例：/home/user/ComfyUI
COMFYUI_ROOT=D:/ComfyUI_portable_TE_v260619

# 以下三项留空则按 COMFYUI_ROOT 自动推导，通常无需修改
COMFYUI_WORKFLOWS_DIR=
COMFYUI_INPUT_DIR=
COMFYUI_OUTPUT_DIR=

# ===================== 模型路径（选填） =====================
# 留空则按 COMFYUI_ROOT 推导；模型权重不入库，需自行下载放置
MODELS_DIR=

# ===================== 显示与显存档案（选填） =====================
# 8G / 16G / server —— 影响超分与视频生成的默认档位
DEPLOY_PROFILE=16G

# ===================== AI 模型密钥（推荐方式） =====================
# 文本分析模型（小说转剧本 / 提示词分析）
MJSCXT_BASE_URL_TEXT=https://integrate.api.nvidia.com/v1
MJSCXT_API_KEY_TEXT=
MJSCXT_MODEL_TEXT=

# 质检模型（需支持图像输入的多模态模型）
MJSCXT_BASE_URL_QC=
MJSCXT_API_KEY_QC=
MJSCXT_MODEL_QC=

# 对话总控模型（AI 对话确定创作设定）
MJSCXT_BASE_URL_CHAT=https://integrate.api.nvidia.com/v1
MJSCXT_API_KEY_CHAT=
MJSCXT_MODEL_CHAT=

# ===================== 密钥加密主密钥（重要） =====================
# 用于加密 output/secrets.enc 中的密钥。
# 留空则自动生成 .secret_key 文件（本地开发够用）；
# 团队/服务器部署请显式设置，并妥善保管——更换后已有加密密钥将无法解密。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MJSCXT_SECRET_KEY=

# ===================== 无人值守托管（选填） =====================
# 是否随服务启动自动恢复「已启用项目」的生产。默认开启（24/7 无人值守）。
# 仅在需要临时独占 GPU 时关闭，例如：跑验证脚本、数据迁移、手工单步生成。
# 关闭写法：MJSCXT_AUTOPILOT=0
MJSCXT_AUTOPILOT=1

# ===================== 服务端口（选填） =====================
APP_HOST=127.0.0.1
APP_PORT=5000

# WSGI 服务器线程数与连接空闲超时（秒）
# 无人值守长时间生产建议保留默认值：单集生成可能持续数十分钟，
# 超时给小了会在生成中途被中间层掐断连接。
APP_THREADS=8
APP_CHANNEL_TIMEOUT=1800


# ===================== 引擎 Provider 选择（P1-4 本地/云端双通道） =====================
# 可选值见 /api/providers 接口（items 列表）。
# image：comfyui-local | doubao-cloud
# video：comfyui-local | wan-cloud | kling-cloud | vidu-cloud | veo-cloud
# tts  ：qwen-tts-local | cosyvoice-cloud
# 留空 = 使用默认本地引擎；云端 Provider 需另行提供各自的鉴权环境变量。
MJSCXT_PROVIDER_IMAGE=comfyui-local
MJSCXT_PROVIDER_VIDEO=comfyui-local
MJSCXT_PROVIDER_TTS=qwen-tts-local
